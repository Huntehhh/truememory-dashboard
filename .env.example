# TrueMemory Dashboard — environment template.
# Copy to .env and fill in the two REQUIRED passwords. Never commit .env.

# ── Postgres (the docker-compose container) ─────────────────────────────────
# REQUIRED — writer-role password. Used by the container, mirror, and refresher.
CLAUDE_USAGE_PG_PASSWORD=change-me-writer

# REQUIRED — read-only role password used by the dashboard server.
# After first `docker compose up`, rotate the bootstrap password to this value:
#   docker exec truememory-dashboard-pg psql -U claude_usage -d claude_usage \
#     -c "ALTER ROLE claude_usage_ro WITH PASSWORD '<this value>';"
CLAUDE_USAGE_PG_RO_PASSWORD=change-me-readonly

# Connection coordinates (defaults match docker-compose.yml).
CLAUDE_USAGE_PG_HOST=127.0.0.1
CLAUDE_USAGE_PG_PORT=5433
CLAUDE_USAGE_PG_DATABASE=claude_usage
CLAUDE_USAGE_PG_USER=claude_usage
CLAUDE_USAGE_PG_RO_USER=claude_usage_ro
CLAUDE_USAGE_PG_VERSION=17.2-alpine

# ── Dashboard server ────────────────────────────────────────────────────────
CLAUDE_USAGE_SERVER_PORT=8503
# TM_DASHBOARD_HOST=127.0.0.1   # bind address; keep host-only unless you know why

# ── Simulator sidecar (proxied through /api/sim) ────────────────────────────
# The dashboard proxies /api/sim/* to the Python simulator sidecar. Set the
# full URL, or leave TM_SIDECAR_URL unset and just override the port.
# TM_SIDECAR_URL=http://127.0.0.1:8504
# TM_SIDECAR_PORT=8504

# ── TrueMemory source (the local SQLite store the mirror reads) ─────────────
# Defaults to ~/.truememory/. Point these at the consumer's TrueMemory install.
# TRUEMEMORY_DB_PATH=~/.truememory/memories.db
# TRUEMEMORY_LOG_PATH=~/.truememory/logs/mcp-debug.log
# TRUEMEMORY_INJECTIONS_LOG_PATH=~/.truememory/injections.log
# TRUEMEMORY_CONFIG_PATH=~/.truememory/config.json

# ── Mirror tuning (optional) ────────────────────────────────────────────────
# TM_MIRROR_POLL_MS=300000
# TM_MIRROR_BATCH_SIZE=5000
# TM_MIRROR_LOG_TAIL_MAX=5242880
# TM_MIRROR_STORE_EMBEDDINGS=false

# ── Matview refresher (optional) ────────────────────────────────────────────
# MATVIEW_REFRESH_MS=30000

# ── Themes / UMAP loop (optional — Python; only if you run the themes page) ──
# TM_THEMES_UMAP_N_NEIGHBORS=15
# TM_THEMES_UMAP_MIN_DIST=0.1
# TM_THEMES_UMAP_SEED=42
# TM_THEMES_HDBSCAN_MIN_CLUSTER=8
# TM_THEMES_HDBSCAN_MIN_SAMPLES=3
